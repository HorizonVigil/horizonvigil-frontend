VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# Default Workers subdomain for the deployed domain APIs — only needed if you
# deploy to a subdomain other than the default (see SERVICE_URLS in src/lib/api.ts).
# VITE_WORKERS_SUBDOMAIN=thequietmind18.workers.dev

# Local dev: run each service with `wrangler dev` from its own services/<name>-api
# directory (each wrangler.jsonc declares a fixed dev port, 8801-8816) and point
# these at localhost. In prod these all default to
# https://cloudops360-1-<domain>-api.thequietmind18.workers.dev if unset — see
# SERVICE_URLS in src/lib/api.ts — so overriding them here is optional even in prod.
VITE_OVERVIEW_API_URL=http://localhost:8801
VITE_AWS_ACCOUNTS_API_URL=http://localhost:8802
VITE_GCP_ACCOUNTS_API_URL=http://localhost:8816
VITE_RESOURCES_API_URL=http://localhost:8803
VITE_CUSTOM_DASHBOARDS_API_URL=http://localhost:8804
VITE_COST_MANAGEMENT_API_URL=http://localhost:8805
VITE_COST_OPTIMIZATION_API_URL=http://localhost:8806
VITE_VULNERABILITY_MANAGEMENT_API_URL=http://localhost:8807
VITE_CONTAINERS_API_URL=http://localhost:8808
VITE_MONITORING_API_URL=http://localhost:8809
VITE_ALERTS_API_URL=http://localhost:8810
VITE_REPORTS_API_URL=http://localhost:8811
VITE_USERS_API_URL=http://localhost:8812
VITE_ORGANIZATION_MANAGEMENT_API_URL=http://localhost:8813
VITE_AUTOMATION_API_URL=http://localhost:8814
VITE_SETTINGS_API_URL=http://localhost:8815
VITE_AI_COPILOT_API_URL=http://localhost:8817

# Test-env only — leave unset in prod to hide the Subscription module
# (see isBillingEnabled() in src/lib/featureFlags.ts).
# VITE_BILLING_API_URL=http://localhost:8818