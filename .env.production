# Baked into the client bundle by Vite at build time (VITE_ prefix) -- every
# value here is already public/client-exposed by design (Supabase's anon/
# publishable key is meant to ship in frontend code; the API URLs are just
# public endpoint hostnames), so committing this file is safe and is what
# prevents a bare `npm run build` from silently producing a broken bundle --
# see the incident this file exists because of: an env-var-less local build
# shipped to prod with an empty VITE_SUPABASE_URL, which throws synchronously
# in supabase.ts's module-level createClient() call and blanks every page.
#
# If any of these Cloud Run services get redeployed under a new URL, update
# here too -- `gcloud run services list --project=cloudops360` is the source
# of truth for current URLs.
VITE_SUPABASE_URL=https://dvyoghaqeknyyrdujssi.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_gRal6V08wNzz0drb1F1QAw_Na-j9XoL
VITE_OVERVIEW_API_URL=https://reports-153395452624.us-central1.run.app
